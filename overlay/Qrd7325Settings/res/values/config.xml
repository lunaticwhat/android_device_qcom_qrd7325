<resources>
    <!-- Hide the AOSP on/off "Smooth display" switch; the panel has three fixed
         modes (60/120/144 Hz), so offer a list of peak rates instead -->
    <bool name="config_show_smooth_display">false</bool>

    <!-- LineageOS: show the peak refresh rate list (one entry per display mode) -->
    <bool name="config_show_peak_refresh_rate_switch">true</bool>
</resources>
